<Window x:Class="NODR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NODR.Controls"
        xmlns:services="clr-namespace:NODR.Services"
        Title="NODR" Icon="pack://application:,,,/Assets/NODR.ico" Width="880" Height="680" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppContent" Grid.RowSpan="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDialogOpen}" Value="True">
                            <Setter Property="Effect"><Setter.Value><BlurEffect Radius="4"/></Setter.Value></Setter>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsUninstallerResidualOpen}" Value="True">
                            <Setter Property="Effect"><Setter.Value><BlurEffect Radius="4"/></Setter.Value></Setter>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Image Source="pack://application:,,,/Assets/NODR-logo.png" Width="27" Height="27" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Image Height="21" Width="91" Stretch="Uniform" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Source" Value="pack://application:,,,/Assets/NODR-wordmark-dark.png"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EffectiveThemeIsDark}" Value="False">
                                        <Setter Property="Source" Value="pack://application:,,,/Assets/NODR-wordmark-light.png"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="11" Padding="3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{services:Loc Nav.Overview}" Command="{Binding ShowOverviewCommand}" Margin="0">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TopNavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsOverviewSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <Button Content="{services:Loc Nav.Cleanup}" Command="{Binding ShowCleanupCommand}" Margin="2,0">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TopNavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsCleanupSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <Button Content="{services:Loc Nav.Files}" Command="{Binding ShowFilesCommand}" Margin="0">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TopNavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsFilesSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <Button Content="{services:Loc Nav.Uninstaller}" Command="{Binding ShowUninstallerCommand}" Margin="2,0,0,0">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TopNavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsUninstallerSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="LanguageMenuButton" Style="{StaticResource CompactImageButton}" Margin="0,0,6,0" ToolTip="{services:Loc Header.LanguageTooltip}" Click="OnLanguageMenuClick">
                        <Image Width="21" Height="21" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Style><Style TargetType="Image"><Setter Property="Source" Value="pack://application:,,,/Assets/Ui/lang-en.png"/><Style.Triggers><DataTrigger Binding="{Binding CurrentLanguageCode}" Value="uk"><Setter Property="Source" Value="pack://application:,,,/Assets/Ui/lang-ua.png"/></DataTrigger><DataTrigger Binding="{Binding CurrentLanguageCode}" Value="ru"><Setter Property="Source" Value="pack://application:,,,/Assets/Ui/lang-ru.png"/></DataTrigger></Style.Triggers></Style></Image.Style>
                        </Image>
                    </Button>
                    <Popup x:Name="LanguagePopup" PlacementTarget="{Binding ElementName=LanguageMenuButton}" Placement="Bottom" HorizontalOffset="-118" VerticalOffset="5" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Style="{StaticResource NodrPopupPanel}" Width="160">
                            <StackPanel>
                                <Button Tag="en" Style="{StaticResource NodrPopupButton}" Click="OnLanguagePopupItemClick"><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/Assets/Ui/lang-en.png" Width="20" Height="20" Margin="0,0,9,0"/><TextBlock Text="English" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Tag="uk" Style="{StaticResource NodrPopupButton}" Click="OnLanguagePopupItemClick"><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/Assets/Ui/lang-ua.png" Width="20" Height="20" Margin="0,0,9,0"/><TextBlock Text="Українська" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Tag="ru" Style="{StaticResource NodrPopupButton}" Click="OnLanguagePopupItemClick"><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/Assets/Ui/lang-ru.png" Width="20" Height="20" Margin="0,0,9,0"/><TextBlock Text="Русский" VerticalAlignment="Center"/></StackPanel></Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button x:Name="ThemeMenuButton" Style="{StaticResource CompactImageButton}" ToolTip="{services:Loc Header.ThemeTooltip}" Click="OnThemeMenuClick">
                        <Image Width="21" Height="21" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Style><Style TargetType="Image"><Setter Property="Source" Value="pack://application:,,,/Assets/Ui/theme-system.png"/><Style.Triggers><DataTrigger Binding="{Binding CurrentThemeMode}" Value="Dark"><Setter Property="Source" Value="pack://application:,,,/Assets/Ui/theme-dark.png"/></DataTrigger><DataTrigger Binding="{Binding CurrentThemeMode}" Value="Light"><Setter Property="Source" Value="pack://application:,,,/Assets/Ui/theme-light.png"/></DataTrigger></Style.Triggers></Style></Image.Style>
                        </Image>
                    </Button>
                    <Popup x:Name="ThemePopup" PlacementTarget="{Binding ElementName=ThemeMenuButton}" Placement="Bottom" HorizontalOffset="-118" VerticalOffset="5" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Style="{StaticResource NodrPopupPanel}" Width="160">
                            <StackPanel>
                                <Button Tag="System" Style="{StaticResource NodrPopupButton}" Click="OnThemePopupItemClick"><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/Assets/Ui/theme-system.png" Width="20" Height="20" Margin="0,0,9,0"/><TextBlock Text="System" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Tag="Dark" Style="{StaticResource NodrPopupButton}" Click="OnThemePopupItemClick"><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/Assets/Ui/theme-dark.png" Width="20" Height="20" Margin="0,0,9,0"/><TextBlock Text="Dark" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Tag="Light" Style="{StaticResource NodrPopupButton}" Click="OnThemePopupItemClick"><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/Assets/Ui/theme-light.png" Width="20" Height="20" Margin="0,0,9,0"/><TextBlock Text="Light" VerticalAlignment="Center"/></StackPanel></Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="PageScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUninstallerSelected}" Value="True">
                            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <Grid Margin="18,12,18,20">
                <!-- OVERVIEW -->
                <Grid Visibility="{Binding IsOverviewSelected, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{services:Loc Overview.Title}" FontSize="28" FontWeight="SemiBold"/>
                            <TextBlock Text="{services:Loc Overview.Subtitle}" Margin="0,6,0,0" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.78">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0"/><TextBlock Text="{Binding SensorStatus}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                            <TextBlock Text="{Binding LastUpdated}" Margin="0,4,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <!-- Compact system status -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="14,11">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="CPU" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding CpuValue}" Margin="0,2,0,0" FontSize="24" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding CpuSubtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="{Binding HasCpuTemperature, Converter={StaticResource BoolToVisibility}}"/><controls:Sparkline Margin="0,5,0,0" Height="24" ItemsSource="{Binding CpuHistory}" Stroke="{DynamicResource AccentBrush}"/></StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="14,11">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="GPU" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding GpuValue}" Margin="0,2,0,0" FontSize="24" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding GpuSubtitle}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}"/><controls:Sparkline Margin="0,5,0,0" Height="24" ItemsSource="{Binding GpuHistory}" Stroke="{DynamicResource AccentBrush}" Visibility="{Binding HasGpuData, Converter={StaticResource BoolToVisibility}}"/></StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="4" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="14,11">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="RAM" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding RamValue}" Margin="0,2,0,0" FontSize="24" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding RamSubtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/><controls:Sparkline Margin="0,5,0,0" Height="24" ItemsSource="{Binding RamHistory}" Stroke="{DynamicResource AccentBrush}"/></StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Primary cleanup status -->
                    <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="18,15">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{services:Loc Overview.CleanupStatus}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding OverviewCleanupHeadline}" Margin="0,5,0,0" FontSize="25" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding OverviewCleanupStatus}" Margin="0,6,24,0" MaxWidth="610" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{services:Loc Overview.QuickCleanup}" Command="{Binding QuickCleanupCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Padding="20,11"/>
                        </Grid>
                    </Border>

                    <!-- Balanced lower dashboard: Storage + Specs / Quick tools -->
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEDA2;" Style="{StaticResource IconText}" Margin="0,1,8,0"/><TextBlock Text="{services:Loc Overview.Storage}" Style="{StaticResource SectionTitle}"/></StackPanel>
                            <Border Margin="0,8,0,0" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="10,6">
                                <ItemsControl ItemsSource="{Binding Disks}"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Button Style="{StaticResource DriveCardButton}" Command="{Binding DataContext.ShowDriveDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,2">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding UsageText}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Grid.Column="2" Text="&#xE76C;" HorizontalAlignment="Right" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextSecondaryBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                                            <ProgressBar Grid.Row="2" Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Foreground="{Binding UsageBrush}" Style="{StaticResource FlatProgressBar}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </Border>

                            <TextBlock Text="{services:Loc Overview.SystemSpecs}" Style="{StaticResource SectionTitle}" Margin="0,12,0,0"/>
                            <Border Margin="0,8,0,0" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="12,10">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="CPU" Style="{StaticResource MutedText}"/><TextBlock Grid.Column="1" Text="{Binding CpuName}" FontSize="11" TextTrimming="CharacterEllipsis"/></Grid>
                                    <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="GPU" Style="{StaticResource MutedText}"/><TextBlock Grid.Column="1" Text="{Binding GpuName}" FontSize="11" TextTrimming="CharacterEllipsis"/></Grid>
                                    <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{services:Loc Overview.System}" Style="{StaticResource MutedText}"/><TextBlock Grid.Column="1" FontSize="11" TextTrimming="CharacterEllipsis"><Run Text="{Binding WindowsInfo, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ArchitectureInfo, Mode=OneWay}"/></TextBlock></Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Column="2" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="{services:Loc Overview.QuickTools}" Style="{StaticResource SectionTitle}"/>
                            <UniformGrid Grid.Row="2" Columns="1" Rows="4" VerticalAlignment="Stretch">
                                <Button Command="{Binding QuickRecycleBinCommand}" Style="{StaticResource QuickToolButton}" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="16" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{services:Loc Overview.RecycleBin}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding RecycleBinSummary}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="2" Text="&#xE76C;" Style="{StaticResource IconText}" VerticalAlignment="Center"/></Grid></Button>
                                <Button Command="{Binding QuickShaderCacheCommand}" Style="{StaticResource QuickToolButton}" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE945;" Style="{StaticResource IconText}" FontSize="16" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{services:Loc Overview.ClearShaderCache}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{services:Loc Overview.ShaderHint}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="2" Text="&#xE76C;" Style="{StaticResource IconText}" VerticalAlignment="Center"/></Grid></Button>
                                <Button Command="{Binding QuickLargeFilesCommand}" Style="{StaticResource QuickToolButton}" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8A5;" Style="{StaticResource IconText}" FontSize="16" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{services:Loc Overview.LargeFilesTool}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{services:Loc Overview.LargeFilesHint}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="2" Text="&#xE76C;" Style="{StaticResource IconText}" VerticalAlignment="Center"/></Grid></Button>
                                <Button Command="{Binding QuickBrowserCleanupCommand}" Style="{StaticResource QuickToolButton}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE774;" Style="{StaticResource IconText}" FontSize="16" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{services:Loc Overview.BrowserCleanup}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{services:Loc Overview.BrowserHint}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="2" Text="&#xE76C;" Style="{StaticResource IconText}" VerticalAlignment="Center"/></Grid></Button>
                            </UniformGrid>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- CLEANUP -->
                <Grid Margin="0,0,0,72" Visibility="{Binding IsCleanupSelected, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Page title: one clear job, no duplicate action. -->
                    <StackPanel>
                        <TextBlock Text="{services:Loc Cleanup.Title}" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="{services:Loc Cleanup.Subtitle}" Margin="0,6,0,0" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Compact scan summary. The destructive action intentionally lives only in the sticky bottom bar. -->
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20,18">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCleanupSuccess}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{services:Loc Cleanup.FoundLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="{Binding HasCleanupResults, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Text="{Binding TotalCleanupSizeText}" Margin="0,2,0,0" FontSize="22" FontWeight="SemiBold" Visibility="{Binding HasCleanupResults, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Text="{Binding CleanupHeadline}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasCleanupResults}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding CleanupStatus}" Margin="0,5,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="360"/>
                            </StackPanel>

                            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="22,0,0,0" VerticalAlignment="Stretch" Visibility="{Binding HasCleanupResults, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{services:Loc Cleanup.PersonalFilesSafe}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{services:Loc Cleanup.PersonalFilesSafeHint}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="330"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{services:Loc Common.Cancel}" Command="{Binding CancelCleanupScanCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Visibility="{Binding CanCancelCleanupScan, Converter={StaticResource BoolToVisibility}}"/>
                                <Button Content="{services:Loc Common.ScanAgain}" Command="{Binding ScanCleanupCommand}" Padding="14,9">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Style.Triggers><DataTrigger Binding="{Binding IsCleanupBusy}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                        <Grid Visibility="{Binding HasCleanupResults, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                            <!-- Selection summary aligns to the exact left/right edges of every category card. -->
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding SelectedCleanupSummaryText}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text=" · " Margin="7,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedCleanupCountText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{services:Loc Common.SelectAll}" Command="{Binding SelectAllCleanupCommand}" Style="{StaticResource LinkButton}" Padding="8,5" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                <Button Grid.Column="3" Content="{services:Loc Common.DeselectAll}" Command="{Binding ClearAllCleanupCommand}" Style="{StaticResource LinkButton}" Padding="8,5" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Grid>

                            <StackPanel Grid.Row="2">
                                <TextBlock Text="{services:Loc Cleanup.Recommended}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding RecommendedCleanupCategories}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="18,14" Margin="0,0,0,10">
                                            <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsRemoving}" Value="True"><DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions></DataTrigger></Style.Triggers></Style></Border.Style>
