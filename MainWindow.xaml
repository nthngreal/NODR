                                <TextBlock Text="{Binding FilesStatus}" Margin="0,7,0,0" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="560"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="28" Visibility="{Binding ShowFilesEmptyState, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                                <Border Width="54" Height="54" CornerRadius="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource SurfaceHoverBrush}" HorizontalAlignment="Center"><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <TextBlock Text="{Binding FilesEmptyTitle}" Margin="0,14,0,0" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding FilesEmptyHint}" Margin="0,7,0,0" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl Grid.Row="4" ItemsSource="{Binding VisibleFiles}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="18,14" Margin="0,0,0,10">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Visibility="{Binding CanQuickRecycle, Converter={StaticResource BoolToVisibility}}"/>
                                        <StackPanel Grid.Column="2"><TextBlock Text="{Binding Name}" ToolTip="{Binding FullPath}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Folder}" ToolTip="{Binding FullPath}" Margin="0,4,20,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Margin="0,7,20,0"><TextBlock Text="{Binding SafetyIcon}" Foreground="{Binding SafetyForeground}" FontSize="13" FontWeight="Bold" Width="20"/><TextBlock Text="{Binding SafetyLabel}" Foreground="{Binding SafetyForeground}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text=" · " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding SafetyCategory}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/></StackPanel></StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding SizeText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Grid.Column="7" Content="{services:Loc Files.Details}" Command="{Binding DetailsCommand}" Style="{StaticResource SecondaryButton}" Padding="11,8" VerticalAlignment="Center"/>
                                        <Button Grid.Column="9" Command="{Binding RecycleCommand}" Style="{StaticResource SecondaryButton}" Padding="11,8" VerticalAlignment="Center" Visibility="{Binding CanQuickRecycle, Converter={StaticResource BoolToVisibility}}" Content="{services:Loc Files.MoveToBin}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>

                <!-- UNINSTALLER -->
                <Grid Height="{Binding ActualHeight, ElementName=PageScroll}" Margin="0,-12,0,-20" Visibility="{Binding IsUninstallerSelected, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="{services:Loc Uninstaller.Title}" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="{services:Loc Uninstaller.Subtitle}" Margin="0,4,0,0" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="11,0,0,0" Panel.ZIndex="2" IsHitTestVisible="False"/>
                                <TextBox x:Name="UninstallerSearchBox" Text="{Binding UninstallerSearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodrTextBox}" Padding="31,7,36,7" ToolTip="{services:Loc Uninstaller.SearchTooltip}" PreviewKeyDown="OnUninstallerSearchPreviewKeyDown"/>
                                <TextBlock Text="{services:Loc Uninstaller.SearchPlaceholder}" Margin="31,0,40,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding UninstallerSearch}" Value=""/><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=UninstallerSearchBox}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" Margin="0,0,4,0" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Command="{Binding ClearUninstallerSearchCommand}" ToolTip="{services:Loc Uninstaller.ClearSearch}">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource LinkButton}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding UninstallerSearch}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                            </Grid>
                            <Button x:Name="UninstallerSortButton" Grid.Column="2" Style="{StaticResource CompactImageButton}" ToolTip="{services:Loc Uninstaller.SortTooltip}" Click="OnUninstallerSortMenuClick">
                                <Viewbox Width="18" Height="18" Stretch="Uniform">
                                    <Canvas Width="20" Height="20">
                                        <Path Data="M3,5 L17,5 M5.5,10 L14.5,10 M8,15 L12,15" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Data="M15.5,13 L17.5,15 L19.5,13" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Popup x:Name="UninstallerSortPopup" PlacementTarget="{Binding ElementName=UninstallerSortButton}" Placement="Bottom" HorizontalOffset="-170" VerticalOffset="5" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Style="{StaticResource NodrPopupPanel}" Width="210"><StackPanel>
                                    <Button Content="{services:Loc Uninstaller.Sort.DateDesc}" Tag="DateDesc" Style="{StaticResource NodrPopupButton}" Click="OnUninstallerSortPopupItemClick"/>
                                    <Button Content="{services:Loc Uninstaller.Sort.DateAsc}" Tag="DateAsc" Style="{StaticResource NodrPopupButton}" Click="OnUninstallerSortPopupItemClick"/>
                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,4"/>
                                    <Button Content="{services:Loc Uninstaller.Sort.SizeDesc}" Tag="SizeDesc" Style="{StaticResource NodrPopupButton}" Click="OnUninstallerSortPopupItemClick"/>
                                    <Button Content="{services:Loc Uninstaller.Sort.SizeAsc}" Tag="SizeAsc" Style="{StaticResource NodrPopupButton}" Click="OnUninstallerSortPopupItemClick"/>
                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,4"/>
                                    <Button Content="{services:Loc Uninstaller.Sort.NameAsc}" Tag="NameAsc" Style="{StaticResource NodrPopupButton}" Click="OnUninstallerSortPopupItemClick"/>
                                    <Button Content="{services:Loc Uninstaller.Sort.NameDesc}" Tag="NameDesc" Style="{StaticResource NodrPopupButton}" Click="OnUninstallerSortPopupItemClick"/>
                                </StackPanel></Border>
                            </Popup>
                            <Button Grid.Column="4" Command="{Binding RefreshInstalledAppsCommand}" Style="{StaticResource CompactImageButton}" ToolTip="{services:Loc Uninstaller.Refresh}">
                                <Viewbox Width="18" Height="18" Stretch="Uniform">
                                    <Canvas Width="20" Height="20">
                                        <Path Data="M16.4,7.2 A7,7 0 1 0 16.7,12.2" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                        <Path Data="M16.5,3.5 L16.5,7.4 L12.6,7.4" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4" MinHeight="0" Margin="0,0,0,20">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="{Binding UninstallerCountText}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding UninstallerStatus}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>

                        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="10">
                            <Grid>
                                <Border Panel.ZIndex="5" Background="{DynamicResource SurfaceBrush}" CornerRadius="11" Visibility="{Binding IsUninstallerBusy, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="260">
                                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
