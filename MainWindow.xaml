                                    <Button Command="{Binding ScanQuickFolderCommand}" CommandParameter="Downloads" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="10,7"><StackPanel Orientation="Horizontal"><TextBlock Text="📥" Margin="0,0,6,0"/><TextBlock Text="{services:Loc Files.Downloads}"/></StackPanel></Button>
                                    <Button Command="{Binding ScanQuickFolderCommand}" CommandParameter="Desktop" Style="{StaticResource SecondaryButton}" Margin="2,0,4,0" Padding="10,7"><StackPanel Orientation="Horizontal"><TextBlock Text="🖥" Margin="0,0,6,0"/><TextBlock Text="{services:Loc Files.Desktop}"/></StackPanel></Button>
                                    <Button Command="{Binding ScanQuickFolderCommand}" CommandParameter="Documents" Style="{StaticResource SecondaryButton}" Margin="4,0,2,0" Padding="10,7"><StackPanel Orientation="Horizontal"><TextBlock Text="📁" Margin="0,0,6,0"/><TextBlock Text="{services:Loc Files.Documents}"/></StackPanel></Button>
                                    <Button Command="{Binding ScanQuickFolderCommand}" CommandParameter="C" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Padding="10,7"><StackPanel Orientation="Horizontal"><TextBlock Text="💾" Margin="0,0,6,0"/><TextBlock Text="{services:Loc Files.EntireC}"/></StackPanel></Button>
                                </UniformGrid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="4">
