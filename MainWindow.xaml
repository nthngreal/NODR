                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                <TextBlock Text="{Binding PublisherLine}" Margin="0,4,0,0" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PublisherLine}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding InstallDateText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="4" Text="{Binding SizeText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <Button Grid.Column="6" Content="{services:Loc Uninstaller.Uninstall}" Command="{Binding DataContext.UninstallAppCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" IsEnabled="{Binding CanUninstall}" Style="{StaticResource DangerButton}" Padding="12,8" VerticalAlignment="Center" ToolTip="{services:Loc Uninstaller.UninstallTooltip}"/>
                                        </Grid>
                                    </DataTemplate></ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasInstalledApps}" Value="False"/><Condition Binding="{Binding IsUninstallerBusy}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <Border Width="54" Height="54" CornerRadius="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource SurfaceHoverBrush}" HorizontalAlignment="Center"><TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock Text="{services:Loc Uninstaller.EmptyTitle}" Margin="0,14,0,0" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{services:Loc Uninstaller.EmptyHint}" Margin="0,7,0,0" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Cleanup action stays anchored to the viewport, independent of the category list scroll position. -->
        <Border Grid.Row="1" Panel.ZIndex="15" VerticalAlignment="Bottom" Margin="22,0,22,14" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCleanupSelected}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        <DataTrigger Binding="{Binding HasCleanupResults}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        <DataTrigger Binding="{Binding IsCleanupSuccess}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedCleanupSummaryText}" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{services:Loc Cleanup.BottomHint}" Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding CleanupProgressText}" Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsCleanupCleaning, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding TopCleanupActionText}" Command="{Binding CleanSelectedCommand}" Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Border>

        <!-- File details is an overlay drawer so clicking Details is visible even when the list is scrolled far down. -->
        <Border Grid.Row="1" Panel.ZIndex="20" Width="470" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="24"
                Visibility="{Binding HasFileDetails, Converter={StaticResource BoolToVisibility}}">
            <Grid DataContext="{Binding SelectedFileDetails}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{services:Loc Files.DetailsTitle}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{services:Loc Files.DetailsSubtitle}" Margin="0,5,20,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{services:Loc Common.Close}" Command="{Binding DataContext.CloseFileDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SecondaryButton}" Padding="11,7"/>
                </Grid>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{services:Loc Files.FullPath}" Margin="0,18,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding FullPath}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{services:Loc Files.SizeModified}" Margin="0,18,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="{Binding SizeText}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text=" · " Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding ModifiedText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                        <TextBlock Text="{services:Loc Files.Assessment}" Margin="0,18,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="{Binding SafetyIcon}" Foreground="{Binding SafetyForeground}" FontWeight="Bold" Width="20"/><TextBlock Text="{Binding SafetyLabel}" Foreground="{Binding SafetyForeground}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text=" · " Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SafetyCategory}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/></StackPanel>
                        <TextBlock Text="{Binding SafetyEffect}" Margin="20,7,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{services:Loc Files.Why}" Margin="0,18,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding SafetyWhy}" Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        <Border Margin="0,20,0,0" Padding="12" CornerRadius="8" Background="{DynamicResource SurfaceHoverBrush}">
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{services:Loc Files.SafetyNote}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="4">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Command="{Binding OpenLocationCommand}" Style="{StaticResource SecondaryButton}" Padding="11,9"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{StaticResource IconText}" Margin="0,0,7,0"/><TextBlock Text="{services:Loc Files.OpenLocation}"/></StackPanel></Button>
                        <Button Grid.Column="2" Command="{Binding OpenParentFolderCommand}" Style="{StaticResource SecondaryButton}" Padding="11,9"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource IconText}" Margin="0,0,7,0"/><TextBlock Text="{services:Loc Files.OpenParent}"/></StackPanel></Button>
                    </Grid>
                    <Button Command="{Binding DataContext.SearchFileNameCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SecondaryButton}" Padding="11,9" Margin="0,0,0,8" Visibility="{Binding CanSearchFileName, Converter={StaticResource BoolToVisibility}}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource IconText}" Margin="0,0,7,0"/><TextBlock Text="{services:Loc Files.SearchName}"/></StackPanel></Button>
                    <Button Command="{Binding DataContext.ShowCleanupCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SecondaryButton}" Padding="11,9" Margin="0,0,0,8" Visibility="{Binding CanOpenCleanup, Converter={StaticResource BoolToVisibility}}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" Margin="0,0,7,0"/><TextBlock Text="{services:Loc Files.OpenCleanup}"/></StackPanel></Button>
                    <Button Command="{Binding DataContext.RecycleFileFromDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource DangerButton}" Padding="11,9" Visibility="{Binding CanRecycleFromDetails, Converter={StaticResource BoolToVisibility}}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" Margin="0,0,7,0"/><TextBlock Text="{services:Loc Files.MoveToBin}"/></StackPanel></Button>
                    <Button Command="{Binding DataContext.DeleteContainingFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource DangerButton}" Padding="11,9" Margin="0,8,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" Margin="0,0,7,0"/><TextBlock Text="{services:Loc Files.MoveParentToBin}"/></StackPanel></Button>
                </StackPanel>
            </Grid>
        </Border>


        <!-- DRIVE DETAILS -->
        <Grid Grid.ColumnSpan="2" Panel.ZIndex="30" Visibility="{Binding HasDriveDetails, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{DynamicResource OverlayBrush}" />
            <Border Width="690" MaxHeight="610" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="26">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{services:Loc Drive.Details}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedDrive.DisplayName}" Margin="0,5,0,0" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                        <Button Grid.Column="1" Content="&#xE711;" Command="{Binding CloseDriveDetailsCommand}" Style="{StaticResource SecondaryButton}" FontFamily="Segoe MDL2 Assets" Padding="11,9"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{services:Loc Drive.Used}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding SelectedDrive.UsedText}" Margin="0,5,0,0" FontSize="19" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="{services:Loc Drive.Total}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding SelectedDrive.TotalText}" Margin="0,5,0,0" FontSize="19" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="{services:Loc Drive.FileSystem}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding SelectedDrive.FileSystem}" Margin="0,5,0,0" FontSize="19" FontWeight="SemiBold"/></StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="4">
                        <TextBlock Text="{services:Loc Drive.SpaceBreakdown}" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DriveBreakdownStatus}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1" Text="{Binding DriveBreakdownPercentText}" Margin="12,0,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsDriveBreakdownBusy, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                        <ProgressBar Height="5" Value="{Binding DriveBreakdownPercent, Mode=OneWay}" Maximum="100" Foreground="{DynamicResource AccentBrush}" Style="{StaticResource FlatProgressBar}" Visibility="{Binding IsDriveBreakdownBusy, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding DriveBreakdownCurrentPath}" Margin="0,7,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DriveBreakdownCurrentPath}" Visibility="{Binding IsDriveBreakdownBusy, Converter={StaticResource BoolToVisibility}}"/>
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding IsDriveBreakdownBusy, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><Border Width="88" Height="10" HorizontalAlignment="Left" Style="{StaticResource SkeletonBar}"/><Border Grid.Column="1" Margin="12,0" Height="7" Style="{StaticResource SkeletonBar}"/><Border Grid.Column="2" Width="48" Height="10" HorizontalAlignment="Right" Style="{StaticResource SkeletonBar}"/></Grid>
                            <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><Border Width="112" Height="10" HorizontalAlignment="Left" Style="{StaticResource SkeletonBar}"/><Border Grid.Column="1" Margin="12,0" Height="7" Style="{StaticResource SkeletonBar}"/><Border Grid.Column="2" Width="42" Height="10" HorizontalAlignment="Right" Style="{StaticResource SkeletonBar}"/></Grid>
                            <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><Border Width="96" Height="10" HorizontalAlignment="Left" Style="{StaticResource SkeletonBar}"/><Border Grid.Column="1" Margin="12,0" Height="7" Style="{StaticResource SkeletonBar}"/><Border Grid.Column="2" Width="54" Height="10" HorizontalAlignment="Right" Style="{StaticResource SkeletonBar}"/></Grid>
                            <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><Border Width="72" Height="10" HorizontalAlignment="Left" Style="{StaticResource SkeletonBar}"/><Border Grid.Column="1" Margin="12,0" Height="7" Style="{StaticResource SkeletonBar}"/><Border Grid.Column="2" Width="46" Height="10" HorizontalAlignment="Right" Style="{StaticResource SkeletonBar}"/></Grid>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding DriveCategories}" Margin="0,7,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                            <Button Command="{Binding OpenCommand}" Style="{StaticResource DriveCategoryButton}" ToolTip="{services:Loc Drive.OpenCategoryTooltip}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="178"/><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="{Binding Brush}" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel>
                                    <ProgressBar Grid.Column="1" Margin="12,0" Height="7" VerticalAlignment="Center" Value="{Binding Percent, Mode=OneWay}" Maximum="100" Foreground="{Binding Brush}" Style="{StaticResource FlatProgressBar}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding PercentText}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Grid>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{services:Loc Drive.ScanHint}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,20,0"/>
                        <Button Grid.Column="1" Content="{services:Loc Drive.OpenExplorer}" Command="{Binding OpenSelectedDriveCommand}" Style="{StaticResource SecondaryButton}"/>
                        <Button Grid.Column="3" Content="{services:Loc Drive.ScanDrive}" Command="{Binding ScanSelectedDriveCommand}" Style="{StaticResource PrimaryButton}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        </Grid>

        <!-- Uninstaller residual review: only leftovers NODR can safely act on are shown. -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="90" Visibility="{Binding IsUninstallerResidualOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{DynamicResource OverlayBrush}"/>
            <Border Width="700" MaxWidth="760" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource ModalSurfaceBrush}" BorderBrush="{DynamicResource ModalBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.42" Color="#000000"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{Binding UninstallerResidualTitle}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding UninstallerResidualStatus}" Margin="0,6,20,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
                        <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Command="{Binding CloseUninstallerResidualsCommand}" Style="{StaticResource SecondaryButton}" Padding="10,8"/>
                    </Grid>
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="9" Padding="12">
                        <StackPanel><TextBlock Text="{Binding UninstallerResidualSummary}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{services:Loc Uninstaller.ResidualSafety}" Margin="0,5,0,0" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="4" MaxHeight="350" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding UninstallerResiduals}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,8">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanClean}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding KindLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text=" · " Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding ConfidenceLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text=" · " Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding DetailText}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><TextBlock Text="{Binding Path}" Margin="0,5,12,0" FontSize="11.5" TextWrapping="Wrap"/></StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </ScrollViewer>
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Content="{services:Loc Uninstaller.RescanResiduals}" Command="{Binding RescanUninstallerResidualsCommand}" Style="{StaticResource SecondaryButton}"/>
                        <Button Grid.Column="2" Content="{services:Loc Common.Close}" Command="{Binding CloseUninstallerResidualsCommand}" Style="{StaticResource SecondaryButton}"/>
                        <Button Grid.Column="4" Content="{services:Loc Uninstaller.CleanResiduals}" Command="{Binding CleanUninstallerResidualsCommand}" Style="{StaticResource DangerButton}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- NODR custom modal overlay: all confirmations and in-app notices use this surface. -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="100" Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{DynamicResource OverlayBrush}"/>
            <Border Width="520" MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource ModalSurfaceBrush}" BorderBrush="{DynamicResource ModalBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.42" Color="#000000"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="{Binding DialogTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Grid.Row="1" Text="{Binding DialogMessage}" Margin="0,10,0,0" FontSize="13" LineHeight="19" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{services:Loc Common.Cancel}" Command="{Binding CancelDialogCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                Visibility="{Binding DialogShowCancel, Converter={StaticResource BoolToVisibility}}"/>
                        <Button Content="{Binding DialogConfirmText}" Command="{Binding ConfirmDialogCommand}" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
