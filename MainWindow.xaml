                                                <StackPanel Grid.Column="3" Width="96" Margin="18,0,0,0" HorizontalAlignment="Right"><TextBlock Text="{Binding SizeText}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="{Binding FileCountText}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/></StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{services:Loc Cleanup.Optional}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,8"/>
                                <ItemsControl ItemsSource="{Binding OptionalCleanupCategories}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="18,14" Margin="0,0,0,10">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center"/>
                                                <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding IconGlyph}" Style="{StaticResource IconText}" FontSize="16" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/><Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="7,2" Margin="9,0,0,0"><TextBlock Text="{Binding SafetyBadge}" FontSize="10" Foreground="{Binding SafetyColor}" FontWeight="SemiBold"/></Border></StackPanel><TextBlock Text="{Binding ImpactDescription}" Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Grid>
                                                <StackPanel Grid.Column="3" Width="96" Margin="18,0,0,0" HorizontalAlignment="Right"><TextBlock Text="{Binding SizeText}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="{Binding FileCountText}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/></StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="28,24" Visibility="{Binding IsCleanupSuccess, Converter={StaticResource BoolToVisibility}}">
