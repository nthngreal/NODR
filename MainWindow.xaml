                                        <Button Content="{services:Loc Files.Sort.Size}" Tag="Size" Style="{StaticResource NodrPopupButton}" Click="OnFilesSortPopupItemClick"/>
                                        <Button Content="{services:Loc Files.Sort.Date}" Tag="Date" Style="{StaticResource NodrPopupButton}" Click="OnFilesSortPopupItemClick"/>
                                    </StackPanel></Border>
                                </Popup>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14,10" Visibility="{Binding HasSelectedSafeFiles, Converter={StaticResource BoolToVisibility}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SelectedFilesSummary}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/><Button Grid.Column="1" Command="{Binding BulkRecycleFilesCommand}" Style="{StaticResource SecondaryButton}" Padding="12,8" Content="{services:Loc Files.MoveSelected}"/></Grid></Border>

                        <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="28" MinHeight="186" Visibility="{Binding IsFilesBusy, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                                <Border Width="54" Height="54" CornerRadius="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource SurfaceHoverBrush}" HorizontalAlignment="Center">
                                    <Viewbox Width="25" Height="25" Stretch="Uniform">
                                        <Canvas Width="24" Height="24">
                                            <Ellipse Width="15" Height="15" Canvas.Left="2" Canvas.Top="2" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"/>
                                            <Path Data="M14.5,14.5 L21,21" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round"/>
