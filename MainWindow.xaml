                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{services:Loc Files.Filter.All}" Command="{Binding SetFilesFilterCommand}" CommandParameter="All"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource FilesFilterChip}"><Style.Triggers><DataTrigger Binding="{Binding IsAllFilesFilter}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="{services:Loc Files.Filter.Archives}" Command="{Binding SetFilesFilterCommand}" CommandParameter="Archives"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource FilesFilterChip}"><Style.Triggers><DataTrigger Binding="{Binding IsArchivesFilesFilter}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="{services:Loc Files.Filter.Videos}" Command="{Binding SetFilesFilterCommand}" CommandParameter="Videos"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource FilesFilterChip}"><Style.Triggers><DataTrigger Binding="{Binding IsVideosFilesFilter}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="{services:Loc Files.Filter.Executables}" Command="{Binding SetFilesFilterCommand}" CommandParameter="Executables"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource FilesFilterChip}"><Style.Triggers><DataTrigger Binding="{Binding IsExecutablesFilesFilter}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="{services:Loc Files.Filter.Caches}" Command="{Binding SetFilesFilterCommand}" CommandParameter="Caches"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource FilesFilterChip}"><Style.Triggers><DataTrigger Binding="{Binding IsCachesFilesFilter}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button x:Name="FilesSortButton" Style="{StaticResource CompactImageButton}" Margin="6,0,0,0" ToolTip="{services:Loc Files.SortTooltip}" Click="OnFilesSortMenuClick">
                                    <Viewbox Width="18" Height="18" Stretch="Uniform"><Canvas Width="20" Height="20"><Path Data="M3,5 L17,5 M5.5,10 L14.5,10 M8,15 L12,15" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Path Data="M15.5,13 L17.5,15 L19.5,13" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Canvas></Viewbox>
                                </Button>
                                <Popup x:Name="FilesSortPopup" PlacementTarget="{Binding ElementName=FilesSortButton}" Placement="Bottom" HorizontalOffset="-174" VerticalOffset="5" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
