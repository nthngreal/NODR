                    <StackPanel>
                        <TextBlock Text="{services:Loc Files.Title}" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="{services:Loc Files.Subtitle}" Margin="0,7,0,0" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20">
